; Four-instruction approach from Raspberry Pi's WS2812 example:
; https://github.com/raspberrypi/pico-examples/blob/master/pio/ws2812/ws2812.pio
; Copyright (c) 2020 Raspberry Pi (Trading) Ltd.
; SPDX-License-Identifier: BSD-3-Clause

.program lights_ws2812
.side_set 1

; 32 cycles at 25.6 MHz = 1.25 us per bit (800 kHz).
; Zero: HIGH 312.5 ns, LOW 937.5 ns. One: HIGH 664 ns, LOW 586 ns.
; Selected to fit the WS2812B V5 timing table, page 3.
.define T1 8
.define T2 9
.define T3 15

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]
    jmp !x do_zero side 1 [T1 - 1]
    jmp bitloop    side 1 [T2 - 1]
do_zero:
    nop            side 0 [T2 - 1]
.wrap
